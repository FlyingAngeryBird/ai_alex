{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskInput",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "maxLength": 160
    },
    "runId": {
      "type": "string",
      "maxLength": 160
    },
    "goalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contextVersion": {
      "type": "integer",
      "minimum": 1
    },
    "deletionEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "cancelled",
        "needs_resume"
      ]
    },
    "goal": {
      "type": "string",
      "maxLength": 2000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 50
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "currentTime": {
      "type": "string",
      "maxLength": 80
    },
    "timezone": {
      "type": "string",
      "maxLength": 100
    },
    "temporary": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "properties": {
        "decisionsRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "toolsRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "activeMsRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "searchQueriesRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "pagesRemaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "decisionsRemaining",
        "toolsRemaining",
        "activeMsRemaining",
        "searchQueriesRemaining",
        "pagesRemaining"
      ],
      "additionalProperties": false
    },
    "validReceiptActionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "refId": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "candidate",
              "artifact",
              "item",
              "receipt"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "resourcePath": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "refId",
          "kind",
          "version",
          "summary",
          "resourcePath"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "loadedSkillIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4
      },
      "maxItems": 6
    },
    "currentArtifact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "maxLength": 160
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "sourceTurnId": {
                  "type": "string",
                  "maxLength": 160
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "plan",
                    "comparison"
                  ]
                },
                "title": {
                  "type": "string",
                  "maxLength": 80
                },
                "content": {
                  "type": "string",
                  "maxLength": 8000
                },
                "sourceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "maxItems": 50
                },
                "savedItemId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "savedItemVersion": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "temporary": {
                  "type": "boolean"
                }
              },
              "required": [
                "artifactId",
                "version",
                "sourceTurnId",
                "kind",
                "title",
                "content",
                "sourceRefs",
                "savedItemId",
                "savedItemVersion",
                "temporary"
              ],
              "additionalProperties": false
            },
            "target": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "artifact",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "taskId",
    "runId",
    "goalVersion",
    "contextVersion",
    "deletionEpoch",
    "status",
    "goal",
    "constraints",
    "sourceRefs",
    "currentTime",
    "timezone",
    "temporary",
    "budget",
    "validReceiptActionIds",
    "observations",
    "loadedSkillIds"
  ],
  "additionalProperties": false
}
