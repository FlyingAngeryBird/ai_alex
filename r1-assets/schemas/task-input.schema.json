{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskInput",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "maxLength": 160
    },
    "runId": {
      "type": "string",
      "maxLength": 160
    },
    "goalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contextVersion": {
      "type": "integer",
      "minimum": 1
    },
    "deletionEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "cancelled",
        "needs_resume"
      ]
    },
    "goal": {
      "type": "string",
      "maxLength": 2000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 50
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "currentTime": {
      "type": "string",
      "maxLength": 80
    },
    "timezone": {
      "type": "string",
      "maxLength": 100
    },
    "temporary": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "properties": {
        "decisionsRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "toolsRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "activeMsRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "searchQueriesRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "pagesRemaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "decisionsRemaining",
        "toolsRemaining",
        "activeMsRemaining",
        "searchQueriesRemaining",
        "pagesRemaining"
      ],
      "additionalProperties": false
    },
    "validReceiptActionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "refId": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "candidate",
              "artifact",
              "item",
              "receipt"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "resourcePath": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "refId",
          "kind",
          "version",
          "summary",
          "resourcePath"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "loadedSkillIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4
      },
      "maxItems": 6
    }
  },
  "required": [
    "taskId",
    "runId",
    "goalVersion",
    "contextVersion",
    "deletionEpoch",
    "status",
    "goal",
    "constraints",
    "sourceRefs",
    "currentTime",
    "timezone",
    "temporary",
    "budget",
    "validReceiptActionIds",
    "observations",
    "loadedSkillIds"
  ],
  "additionalProperties": false
}
