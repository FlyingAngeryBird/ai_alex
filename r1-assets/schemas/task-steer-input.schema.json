{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskSteerInput",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "maxLength": 160
    },
    "taskId": {
      "type": "string",
      "maxLength": 160
    },
    "newGoalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "currentStatus": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "cancelled",
        "needs_resume"
      ]
    },
    "goal": {
      "type": "string",
      "maxLength": 2000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 50
    },
    "sourceTurnIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "validReceiptActionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 50
    }
  },
  "required": [
    "eventId",
    "taskId",
    "newGoalVersion",
    "currentStatus",
    "goal",
    "constraints",
    "sourceTurnIds",
    "validReceiptActionIds"
  ],
  "additionalProperties": false
}
