{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextSummary",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "有效主题及已确认背景",
      "maxLength": 1600
    },
    "sourceTurnIds": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "使用输入或工具回执中实际存在的ID",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "memoryIds": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "使用输入或工具回执中实际存在的ID",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "taskFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "使用输入或工具回执中实际存在的ID",
            "maxLength": 160
          },
          "goalVersion": {
            "type": "integer",
            "minimum": 1
          },
          "goal": {
            "type": "string",
            "description": "当前目标",
            "maxLength": 2000
          },
          "confirmedConditions": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "明确条件",
              "maxLength": 500
            },
            "maxItems": 50
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "待解决项",
              "maxLength": 500
            },
            "maxItems": 50
          }
        },
        "required": [
          "taskId",
          "goalVersion",
          "goal",
          "confirmedConditions",
          "unresolved"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "required": [
    "summary",
    "sourceTurnIds",
    "memoryIds",
    "taskFacts"
  ],
  "additionalProperties": false
}
