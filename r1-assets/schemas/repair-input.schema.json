{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepairInput",
  "type": "object",
  "properties": {
    "schemaId": {
      "type": "string",
      "enum": [
        "task-draft",
        "memory-candidates",
        "context-summary"
      ]
    },
    "targetSchema": {
      "type": "object"
    },
    "invalidOutput": {
      "type": "string",
      "maxLength": 20000
    },
    "validationErrors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 50
    },
    "validReferenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      },
      "maxItems": 50
    },
    "sourceSnapshot": {
      "type": "object"
    }
  },
  "required": [
    "schemaId",
    "targetSchema",
    "invalidOutput",
    "validationErrors",
    "validReferenceIds",
    "sourceSnapshot"
  ],
  "additionalProperties": false
}
