{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona",
  "type": "object",
  "properties": {
    "assistantName": {
      "type": "string",
      "maxLength": 20,
      "minLength": 1
    },
    "userAddress": {
      "type": "string",
      "maxLength": 20
    },
    "style": {
      "type": "string",
      "maxLength": 2000
    },
    "voiceId": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "assistantName",
    "userAddress",
    "style",
    "voiceId",
    "version"
  ],
  "additionalProperties": false
}
